# String de conexão do MongoDB Atlas (Database > Connect > Drivers)
MONGODB_URI="mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
# Nome do banco
MONGODB_DB="gerenciador-tarefas"

# Segredo usado para assinar a sessão de login. Gere um com:
#   npx auth secret     ou     openssl rand -base64 32
NEXTAUTH_SECRET="troque-por-um-segredo-longo-e-aleatorio"
# Endereço do app (local). Na Vercel não é necessário definir.
NEXTAUTH_URL="http://localhost:3000"
